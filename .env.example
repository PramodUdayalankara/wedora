# Wedora Supabase Configuration
# Use the browser-safe publishable key from Supabase Project Settings > API Keys.
# The legacy anon public key is also supported as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Note: If these variables are not provided, Wedora automatically runs in
# offline Interactive Demo Mode with pre-seeded sample Sri Lankan chocolate orders.
